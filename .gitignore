# ==============================================================================
# SkillXchange — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
# Explicitly preserve safe configuration template
!.env.example

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Local Package Trees
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches & Temporary Files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test, coverage, logs & tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.log

# ------------------------------------------------------------------------------
# 4. Local SQLite Databases & Database Sidecars
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
instance/

# ------------------------------------------------------------------------------
# 5. User Uploads, Backups & Local Scratch Artifacts
# ------------------------------------------------------------------------------
app/static/uploads/*
!app/static/uploads/.gitkeep
scratch/
tmp/
temp/

# Isolated Cloudflare Proof of Concept
cloudflare_poc/

# Unrelated Documentation & Screenshots Subfolder
SkillXchange/

# Local historical phase backups (preserved on disk, excluded from repository)
backup_original/
backup_phase1/
backup_phase2/

# ------------------------------------------------------------------------------
# 6. IDE, Editor & Operating System Metadata
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~


# Exclude development-only seed script and outdated/private notes
/seed.py
/requirements_original.txt
/docs/SESSION_CHECKPOINT.md
/docs/
