# Flask Application Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (Leave unset for local SQLite default)
# DATABASE_URL=postgresql://user:password@hostname:5432/skillxchange_db

# WebSocket Allowed Origins (comma-separated domains in production, or * in local dev)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Mail Configuration (Flask-Mail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# SMS Provider Configuration (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
